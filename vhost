#!/usr/bin/env bash
# Install and enable the Apache vhost for http://localhost:8080 -> /var/www/fastblips
set -euo pipefail
cd "$(dirname "$0")"
sudo mkdir -p /var/www/fastblips
sudo cp apache/fastblips-local.conf /etc/apache2/sites-available/fastblips-local.conf
grep -qE '^\s*Listen\s+(\S+:)?8080\b' /etc/apache2/ports.conf || echo 'Listen 8080' | sudo tee -a /etc/apache2/ports.conf >/dev/null
sudo a2enmod headers >/dev/null
sudo a2ensite fastblips-local >/dev/null
sudo apache2ctl configtest
sudo systemctl restart apache2
echo 'FastBlips is served at http://localhost:8080'
