' Button and Label demo. Run it from a launch window (the console's Launch
' menu) or as a page: index.html?run=button-demo after saving it to the
' Basic database under that name.
'
' Widgets are placed with left and top, and sized with width and height,
' all in pixels from the top left of the screen.

Dim clicks = 0

Dim title = AddLabel("Click the button!", 20, 20, 240, 24)
Dim counter = AddLabel("Clicks: 0", 20, 50, 240, 24)
Dim clickMe = AddButton("Click me", 20, 84, 120, 32)
Dim startOver = AddButton("Start over", 150, 84, 110, 32)

' Each click calls the Sub named here. The program's top-level code ends
' below, but the program keeps running, waiting for clicks, until Reset.
OnClick(clickMe, "ClickMeClicked")
OnClick(startOver, "StartOverClicked")

Sub ClickMeClicked()
  clicks = clicks + 1
  SetText(counter, "Clicks: " & clicks)
  If clicks = 10 Then
    ' Move the button down and make it bigger.
    SetText(title, "Ten clicks. Impressive!")
    SetText(clickMe, "Keep going")
    SetBounds(clickMe, 20, 126, 240, 40)
  End If
End Sub

' A handler may take one argument: the widget that was clicked.
Sub StartOverClicked(button)
  Transcript GetText(button) & " after " & clicks & " clicks"
  clicks = 0
  SetText(title, "Click the button!")
  SetText(counter, "Clicks: 0")
  SetText(clickMe, "Click me")
  SetBounds(clickMe, 20, 84, 120, 32)
End Sub
