' A tour of the widgets. Run it from a launch window (a console's Launch
' menu) or as a page: index.html?run=widget-tour after saving it to the Basic
' database under that name.
'
' The screen is a column (VPanel) filling the screen: a title, a toolbar
' row, a split panel with a list on the left and tabs on the right, and a
' button bar at the bottom. A floating Window sits on top.

Dim page = New VPanel()
page.fill()
page.setPadding(4)
page.setSpacing(4)

Dim title = New Label("Widget tour: add some items, then pick one")
page.add(title)

' The toolbar: a row of buttons and a menu, pushed left by a Spacer.
Dim toolbar = New HPanel()
toolbar.setSpacing(4)
page.add(toolbar)
Dim addButton = New Button("Add item")
toolbar.add(addButton)
Dim clearButton = New Button("Clear")
toolbar.add(clearButton)
Dim colours = New Menu("Colour")
toolbar.add(colours)
colours.addItem("Plain", "ColourChosen")
colours.addSeparator()
colours.addItem("lightyellow", "ColourChosen")
colours.addItem("lightblue", "ColourChosen")
toolbar.add(New Spacer())

' A list on the left, tabs on the right; the split takes the rest of the column.
Dim split = New HSplitPanel()
split.setFlex(1)
split.setPosition(0.35)
page.add(split)
Dim list = New ListPanel()
list.setEmptyText("(no items yet)")
split.setFirst(list)
Dim tabs = New TabPanel()
split.setSecond(tabs)
Dim notes = New TextPanel("Type here. Ctrl+Enter copies the text to the title.")
tabs.addTab("Notes", notes)
Dim code = New MonacoPanel("Print ""Hello from a MonacoPanel""", "vb")
tabs.addTab("Code", code)

Dim bar = New ButtonBar()
page.add(bar)
Dim about = bar.addButton("About")

' A floating window with its own content and button bar.
Dim box = New Window("About")
Dim text = New Label("Made with FastBlip widgets")
box.setContent(text)
box.setBounds(120, 120, 280, 140)
box.getButtonBar().addButton("OK").onClick("CloseAbout")
box.close()

addButton.onClick("AddItem")
clearButton.onClick("ClearItems")
list.onSelect("Picked")
tabs.onSelect("TabChosen")
notes.onSubmit("NotesSubmitted")
about.onClick("ShowAbout")

Sub AddItem()
  list.addItem("Item " & (list.getCount() + 1))
End Sub

Sub ClearItems()
  list.clear()
  title.setText("Cleared")
End Sub

' An onSelect handler gets the widget and the index of the row picked.
Sub Picked(w, index)
  If index >= 0 Then title.setText("Picked " & w.getItem(index))
End Sub

Sub TabChosen(w, index)
  title.setText("Showing the " & w.getSelectedText() & " tab")
End Sub

Sub NotesSubmitted(w)
  title.setText(w.getText())
End Sub

' A menu item's handler gets the menu and the item's label.
Sub ColourChosen(menu, label)
  If label = "Plain" Then
    list.setBackground("")
  Else
    list.setBackground(label)
  End If
End Sub

Sub ShowAbout()
  box.open()
End Sub

Sub CloseAbout()
  box.close()
End Sub
