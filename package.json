{
  "name": "crumb-lang",
  "version": "0.1.0",
  "description": "Crumb v0.1 and MiniPy: two front ends, one bytecode and VM",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "crumb": "bin/crumb.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./lexer": "./src/vm/compiler/basic/lexer.js",
    "./parser": "./src/vm/compiler/basic/parser.js",
    "./compiler": "./src/vm/compiler/basic/compiler.js",
    "./vm": "./src/vm/vm.js",
    "./opcodes": "./src/vm/opcodes.js",
    "./python": "./src/vm/compiler/python/loader.js",
    "./loader": "./src/vm/compiler/basic/loader.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build": "node web/build.mjs --standalone && node web/build.mjs",
    "watch": "node web/watch.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
