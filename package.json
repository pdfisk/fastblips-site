{
  "name": "crumb-lang",
  "version": "0.1.0",
  "description": "BlipPy (a Python subset): front end, bytecode and VM. The Basic (Crumb) front end is archived.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "crumb": "bin/crumb.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./vm": "./src/vm/vm.js",
    "./opcodes": "./src/vm/opcodes.js",
    "./python": "./src/vm/compiler/python/loader.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build": "node web/build.mjs --standalone && node web/build.mjs",
    "watch": "node web/watch.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
